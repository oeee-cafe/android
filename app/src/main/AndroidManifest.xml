<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The unreachable screen tries again when the network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Saving a drawing or a file to Pictures or Downloads; from Android 10 that needs nothing. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".OeeeCafeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.OeeeCafe">

        <!-- Digital Asset Links for credential sharing -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OeeeCafe"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <!-- The web view lives as long as the activity, so it isn't recreated on rotation, resizing
                 or a change of font size (the pages follow that themselves, MainActivity.onConfigurationChanged).
                 Links opened from other apps come to the one activity instead of starting another in their task. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to the site open in the app (verified through https://oeee.cafe/.well-known/assetlinks.json) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="oeee.cafe" />
            </intent-filter>

            <!-- The app's own scheme, all of it. Coming back from a sign-in done in a
                 browser is what uses it today (oeee-cafe://handoff/done, SignInHandoff):
                 the site sends the browser there once the provider has answered, and the
                 only thing it is for is bringing this activity forward. singleTask hands
                 it to onNewIntent, onResume follows, and the page asks the site at once
                 (MainActivity.onResume).

                 Nothing is loaded from any of it. OpenedFrom opens a page for https
                 links to the site and for nothing else, so a URL of this scheme
                 opens the app and goes no further, whatever is in it. Anything this
                 scheme is given to mean later is routed there, deliberately, rather than
                 arriving here by having been claimed already. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="oeee-cafe" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging Service -->
        <service
            android:name=".OeeeCafeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- What FCM shows by itself, for a push that arrives while the app is not in front:
             the app's own channel (OeeeCafeMessagingService) rather than FCM's "Miscellaneous"
             one, and its icon and colour. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="oeee_cafe_notifications" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    
    <!-- Required: set your sentry.io project identifier (DSN) -->
    <meta-data android:name="io.sentry.dsn" android:value="https://42e7d92292cd4b19516d940090eaa71d@o4504757655764992.ingest.us.sentry.io/4510413283917824" />
    <!-- No request headers, IP address or device name: a request to the site carries its session cookie. -->
    <meta-data android:name="io.sentry.send-default-pii" android:value="false" />

    <!-- enable automatic breadcrumbs for user interactions (clicks, swipes, scrolls) -->
    <meta-data android:name="io.sentry.traces.user-interaction.enable" android:value="true" />
    <!-- No screenshots with crashes: the screen is the site, and on it someone's private drawings and messages. -->
    <meta-data android:name="io.sentry.attach-screenshot" android:value="false" />
    <!-- enable view hierarchy for crashes -->
    <meta-data android:name="io.sentry.attach-view-hierarchy" android:value="true" />

    <!-- enable the performance API by setting a sample-rate, adjust in production env -->
    <meta-data android:name="io.sentry.traces.sample-rate" android:value="1.0" />
    <!-- enable Sentry Logs -->
    <meta-data android:name="io.sentry.logs.enabled" android:value="true" />

        <!-- Hands a drawing being shared or copied to other apps (MediaFiles). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>